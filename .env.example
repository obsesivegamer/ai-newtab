# Only needed for the Node/Bun harness in harness/. The extension asks for the key in its UI.
ANTHROPIC_API_KEY=
# Optional: standing instructions for harness runs (same as the extension's Settings box)
HOMEPAGE_PROMPT=
# Optional: base URL of the Amber article archive the harness reads. Unset means http://127.0.0.1:8080;
# set it to an empty value (AMBER_URL=) to run without the archive.
# AMBER_URL=http://127.0.0.1:8080

# Live feeds for `pnpm agent:run` (the extension reads Settings -> Sources instead).
# Comma-separated RSS/Atom addresses. Unset: the publications your archive names
# (else a few well-known ones). An empty value (FEEDS=) runs without feeds.
# FEEDS=https://www.theguardian.com/world/rss,https://feeds.arstechnica.com/arstechnica/index
