{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/platform": ["./src/platform.ts"],
      "@/lib/browser-capture": ["./src/shims/browser-capture.ts"],
      "@/*": ["../extension/*"],
      "@newtab/*": ["../extension/entrypoints/newtab/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
